# Copy this file to .env and fill in your own values. Never commit .env.

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Model ID used for all generation. Check the Groq docs for currently supported models.
GROQ_MODEL=openai/gpt-oss-120b

# Set to false if your chosen model doesn't support JSON mode.
GROQ_JSON_MODE=true

# Optional
# GROQ_TIMEOUT_SECONDS=45
# GROQ_MAX_RETRIES=2
# GROQ_MAX_OUTPUT_TOKENS=3000
# DATABASE_URL=sqlite:///./data/creatoros.db
# FRONTEND_ORIGIN=http://localhost:5173

# Image generation. Leave IMAGE_API_KEY empty to disable generation; uploads still work.
# Get a key from your Pollinations account. Keep it on the backend only.
IMAGE_PROVIDER=pollinations
IMAGE_API_KEY=your-pollinations-api-key-here
IMAGE_MODEL=flux
# MAX_UPLOAD_MB=5
